# Copia este archivo como .env y llena los valores. El archivo .env NUNCA se sube al repositorio.

# development, test o production
ENTORNO=development
HOST=127.0.0.1
PORT=3000

# Usuario de la base que pertenece al grupo fqs_backend (ver db/03_roles.sql), nunca postgres
DATABASE_URL=postgresql://fqs_api:CAMBIA_ESTA_CONTRASENA@localhost:5432/familiasquesuman

# disable solo para una base local. En un servidor usa require o verify-full
DB_SSL=disable
# DB_SSL_CA=/ruta/al/certificado-ca.pem
DB_POOL_MAX=10

# Cantidad de proxies inversos delante del backend (Nginx o Caddy cuenta como 1)
TRUST_PROXY=0

ACCESS_TTL_MINUTOS=15
REFRESH_TTL_DIAS=30

# Carpeta privada donde se guardan las imágenes subidas
UPLOAD_DIR=./uploads

LOG_LEVEL=info

# Notificaciones push. Ruta al JSON de la cuenta de servicio de Firebase.
# Ese archivo es una credencial, nunca se sube al repositorio. Sin esta variable
# las notificaciones se ven dentro de la app pero no llegan como push.
# FCM_CUENTA_SERVICIO=./firebase-cuenta-servicio.json
AVISOS_CADA_MINUTOS=5

# Segundo factor de administración. obligatorio es lo correcto, opcional solo para pruebas locales
ADMIN_2FA=obligatorio
# 32 bytes aleatorios en base64. Genéralos con  python -m fqs.scripts.generar_clave
# Si se pierde, cada cuenta de administración tiene que volver a activar su segundo factor
CLAVE_CIFRADO_2FA=

# Correo de recuperación con Brevo (https://www.brevo.com). Sin la llave el código solo
# aparece en la consola en desarrollo
# BREVO_API_KEY=
# CORREO_REMITENTE=no-responder@tu-dominio.mx
# CORREO_REMITENTE_NOMBRE=Familias que Suman

# Respaldos cifrados (python -m fqs.scripts.respaldo). Usuario dueño del schema, no el del backend
# RESPALDO_DATABASE_URL=postgresql://postgres:CAMBIA_ESTA_CONTRASENA@localhost:5432/familiasquesuman
# Otra clave distinta, guárdala también fuera del servidor
# RESPALDO_CLAVE=
# RESPALDO_DIR=./respaldos
# RESPALDO_CONSERVAR=14
# Carpeta de pg_dump si no está en el PATH (en Windows algo como C:/Program Files/PostgreSQL/16/bin)
# PG_BIN=

# Alertas de seguridad y ancla semanal de la bitácora (además de las cuentas de administración)
# ALERTAS_CORREO=direccion@tu-dominio.mx
# ANCLA_CADA_DIAS=7
# Revisión de contraseñas filtradas con Pwned Passwords (revisar o no_revisar)
CONTRASENAS_FILTRADAS=revisar
# Sesiones de administración, minutos sin uso y tope en horas
ADMIN_INACTIVIDAD_MINUTOS=30
ADMIN_SESION_HORAS=12
# Meses sin entrar antes de avisar que la cuenta se eliminará
CUENTAS_INACTIVAS_MESES=24
# Solo durante una rotación de CLAVE_CIFRADO_2FA (ver python -m fqs.scripts.rotar_clave_2fa)
# CLAVES_CIFRADO_2FA_ANTERIORES=
# Retención de la bitácora para python -m fqs.scripts.podar_bitacora
# BITACORA_RETENCION_MESES=12

# SMS para verificar teléfonos y recuperar contraseñas por teléfono. brevo usa la misma
# BREVO_API_KEY y necesita créditos de SMS en Brevo. Sin SMS, en desarrollo el código sale en
# la consola y en producción el registro solo con teléfono responde que no está disponible
SMS=desactivado
# SMS_REMITENTE=FamSuman
# Topes contra el fraude de bombeo de SMS
# SMS_MAX_DIA=200
# SMS_MAX_NUMERO_DIA=5

# Métricas para Prometheus en un puerto aparte del de la API (0 las apaga). Nunca uses el mismo
# valor que PORT. En Docker escuchan solo en la red de monitoreo (ver docker-compose.yml)
METRICAS_PUERTO=0
# METRICAS_HOST=127.0.0.1
