# Variables para docker compose. Copia como .env.docker, nunca lo subas al repositorio.
# Genera cada clave con  python -m fqs.scripts.generar_clave  (o openssl rand -base64 32)

# Dominio que apunta a este servidor. localhost para probar en tu computadora
FQS_DOMINIO=localhost

# Contraseñas de la base, largas y distintas
POSTGRES_PASSWORD=
FQS_API_PASSWORD=

# Cifrado del segundo factor y de los respaldos. Claves distintas. Guarda una copia fuera del servidor
CLAVE_CIFRADO_2FA=
RESPALDO_CLAVE=

# Correo de recuperación (Brevo). El remitente debe estar verificado en Brevo
BREVO_API_KEY=
CORREO_REMITENTE=

# Correos que reciben alertas de seguridad y el ancla semanal de la bitácora, además de las
# cuentas de administración. Conviene uno de alguien que no administre el servidor
ALERTAS_CORREO=

# SMS por Brevo (brevo o desactivado). Necesita créditos de SMS en Brevo
SMS=desactivado

# Túnel de Cloudflare para la demostración por internet (perfil tunel, ver docs/seguridad/despliegue.md)
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana (http://127.0.0.1:3001 en el servidor). Contraseña larga, solo para quien opera el servidor
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
