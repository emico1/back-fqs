        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "fqs-prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (le) (rate(fqs_peticion_duracion_segundos_bucket{ruta!=\"/v1/cupos/stream\"}[5m])))",
          "legendFormat": "p50",
          "range": true
